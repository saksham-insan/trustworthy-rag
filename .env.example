# Copy this file to .env and fill in your own free-tier keys. Never commit .env itself.

GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Which LLM to use for generation vs verification (start with different providers
# so a rate limit on one doesn't block the whole pipeline)
GENERATOR_PROVIDER=gemini      # gemini | groq
VERIFIER_PROVIDER=groq         # gemini | groq
